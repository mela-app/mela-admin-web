# Copy to .env (gitignored) and adjust. Nothing here is secret, but every
# address the console uses outside production comes from this file - the
# code has no built-in ones.

# `npm run dev` / `npm run preview`: the API that /v1 is proxied to -
# mela-backend on this machine.
ADMIN_API_ORIGIN=http://localhost:3000

# `docker compose up -d --build` (the production image, locally):
# where the console listens on this machine (127.0.0.1 only),
ADMIN_PORT=8080
# where its nginx sends /v1 - the API on this machine, seen from a container,
API_UPSTREAM=http://host.docker.internal:3000
# and where avatars and chat photos may load from besides the console itself
# (the backend's S3_PUBLIC_URL_BASE origin - S3Mock here).
CSP_IMG_SRC="https: http://localhost:9090"

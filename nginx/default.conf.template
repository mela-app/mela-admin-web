# The admin console: the static build, and /v1 proxied to the API.
# A template: API_UPSTREAM and CSP_IMG_SRC are filled in at start-up. CSP_IMG_SRC
# (the storage's address) is also where camera effect files are uploaded to.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Every response. A location with an add_header of its own would drop
    # these, so the locations below set caching with `expires` instead.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${CSP_IMG_SRC}; font-src 'self' data:; connect-src 'self' ${CSP_IMG_SRC}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location /v1/ {
        # Resolved per request through Docker's DNS, so a restarted backend
        # (new IP) is found again without restarting nginx.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api ${API_UPSTREAM};
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Passed through, not appended: the API trusts one proxy hop
        # (TRUST_PROXY=1) - the TLS proxy in front, which sets these.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Content-hashed file names: safe to cache for a year.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # The single-page app. index.html is revalidated every time, so a new
    # deploy shows up at once.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
